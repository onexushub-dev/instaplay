{
  "expo": {
    "name": "Repplay",
    "slug": "repplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "repplay",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.repplay.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "O Repplay usa a câmera para gravar seus clipes.",
        "NSMicrophoneUsageDescription": "O Repplay grava o som dos seus clipes.",
        "NSSpeechRecognitionUsageDescription": "O Repplay escuta você dizer \"salvar\" ou \"gravar\" para salvar o clipe sem tocar no celular.",
        "LSApplicationQueriesSchemes": [
          "instagram-stories"
        ],
        "NSPhotoLibraryAddUsageDescription": "O Repplay salva os clipes que você exportar na sua galeria.",
        "NSLocalNetworkUsageDescription": "O Repplay usa a rede local para conversar com o outro celular que serve de controle.",
        "NSBonjourServices": [
          "_repplay-remote._tcp",
          "_repplay-remote._udp"
        ],
        "NSBluetoothAlwaysUsageDescription": "O Repplay usa o Bluetooth para conversar com o outro celular que serve de controle.",
        "UIBackgroundModes": [
          "bluetooth-central"
        ]
      },
      "appleTeamId": "2J67Z98LDX"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B09",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.repplay.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F100D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-video",
      "expo-sharing",
      "@bacons/apple-targets",
      "./plugins/withPodsDeploymentTarget",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "metaAppId": ""
    }
  }
}
