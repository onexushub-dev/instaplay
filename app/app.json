{
  "expo": {
    "name": "LANCE",
    "slug": "lance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lance",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.lance.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "LANCE uses the camera to record your clips.",
        "NSMicrophoneUsageDescription": "LANCE records the sound of your clips.",
        "NSSpeechRecognitionUsageDescription": "LANCE listens for you to say \"save\" or \"record\" so you can save a clip without touching your phone.",
        "LSApplicationQueriesSchemes": [
          "instagram-stories"
        ],
        "NSPhotoLibraryAddUsageDescription": "LANCE saves the clips you export to your photo library.",
        "NSLocalNetworkUsageDescription": "LANCE uses your local network to talk to the other phone you use as a remote.",
        "CFBundleAllowMixedLocalizations": true,
        "NSBonjourServices": [
          "_lance-remote._tcp",
          "_lance-remote._udp"
        ]
      },
      "appleTeamId": "2J67Z98LDX"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.lance.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-video",
      "expo-sharing",
      "@bacons/apple-targets",
      "./plugins/withPodsDeploymentTarget",
      "expo-image",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "pt-BR"],
            "android": ["en", "pt-BR"]
          },
          "allowDynamicLocaleChangesAndroid": true
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "pt-BR": "./locales/pt-BR.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "metaAppId": ""
    }
  }
}
