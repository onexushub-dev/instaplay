{
  "expo": {
    "name": "LANCE",
    "slug": "lance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lance",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.lance.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "O LANCE usa a câmera para gravar seus clipes.",
        "NSMicrophoneUsageDescription": "O LANCE grava o som dos seus clipes.",
        "NSSpeechRecognitionUsageDescription": "O LANCE escuta você dizer \"salvar\" ou \"gravar\" para salvar o clipe sem tocar no celular.",
        "LSApplicationQueriesSchemes": [
          "instagram-stories"
        ],
        "NSPhotoLibraryAddUsageDescription": "O LANCE salva os clipes que você exportar na sua galeria."
      },
      "appleTeamId": "2J67Z98LDX"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.lance.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-video",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "metaAppId": ""
    }
  }
}
